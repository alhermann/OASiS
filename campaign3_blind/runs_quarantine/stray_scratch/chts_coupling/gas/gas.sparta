# SPARTA deck for conjugate heat transfer - gas side
seed                12345
dimension           2
boundary            ss p p
create_box          0.0010000000 0.0020000000 0.0000000000 0.0006000000 -0.5 0.5
create_grid         30 18 1
species             ar.species Ar
mixture             gas Ar temp 300.0
global              nrho 1.332700e+22 fnum 1.688302e-12
collide             vss gas ar.vss
timestep            1.0e-07

# Read surface geometry
read_surf           walls.surf group all

# Import wall temperatures via custom surf attribute
custom              surf create tsurf float 0 file tsurf.in 1 tsurf

# Left wall (surface 1, interface): diffuse with imported temperature
surf_collide        1 diffuse s_tsurf 1.0

# Right wall (surface 2): diffuse at fixed temperature
surf_collide        2 diffuse 200.0 1.0

surf_modify         all collide 1

# Create particles
create_particles    gas n 0

# Compute surface heat flux (etot = energy flux into wall)
compute             1 surf all all etot

# Average over last NAVG timesteps
fix                 1 ave/surf all 1 4000 4000 c_1[1] ave one

# Dump surface data every NRUN steps (just once at end)
dump                1 surf all 6000 flux.out id v1x v1y v2x v2y f_1 s_tsurf

# Statistics
stats               6000
stats_style         step cpu np nscoll nbound
run                 6000
