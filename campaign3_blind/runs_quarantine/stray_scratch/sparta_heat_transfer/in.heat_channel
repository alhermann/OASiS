# SPARTA DSMC simulation: 2D channel with heat transfer
# Bottom wall at 223 K, top wall at 323 K, periodic in x
# Argon gas, Kn ~ 0.05 (slip regime)

seed             42
dimension        2

# Boundaries: periodic in x, surface in y
boundary         p ss p

# Domain: x from 0 to Lx, y from 0 to H, z straddles 0 for 2D
create_box       0.0 2.5e-4 0.0 1.0e-3 -0.5 0.5

# Grid: 16 x 64 x 1 (cell size ~1.56e-5 m < lambda/3)
create_grid      16 64 1

# Species and mixture
species          ar.species Ar
mixture          gas Ar vstream 0.0 0.0 0.0 temp 273.0

# Global density and fnum (will be set per level)
global           nrho 2.6e+22 fnum 3.17e+11

# Collision model
collide          vss gas ar.vss

# Surface collision models: fully diffuse at specified temperatures
surf_collide     bottom_wall diffuse 223.0 1.0
surf_collide     top_wall diffuse 323.0 1.0

# Assign surfaces to boundaries
bound_modify     ylo collide bottom_wall
bound_modify     yhi collide top_wall

# Create particles
create_particles gas n 0

# Compute total temperature for monitoring
compute          temp_global temp

# For heat flux, we need to track energy at boundaries
# The key insight: in DSMC with diffuse walls, particles hitting the wall
# are re-emitted with Maxwellian at wall temperature
# Heat flux = (energy_out - energy_in) / (area * time)

# We can estimate this from the number of boundary collisions and 
# the temperature difference

# Stats output every 100 steps
stats_style      step np nscoll ncoll c_temp_global
stats            100

timestep         2.0e-8
run              50000
