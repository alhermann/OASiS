################################################################################
# Thermal transpiration between parallel plates
# 2D channel with periodic x boundaries, walls at y=0 and y=H
# Bottom wall at T=223 K, top wall at T=323 K
# Argon gas, Kn = 0.05 (slip regime)
# Level 2: ~80 particles per cell (4x level 1)
################################################################################

seed	    	    42
dimension   	    2

# Global settings
global		    gridcut 0.0 comm/sort yes

# Domain: periodic in x, reflective walls at y=0 and y=H
boundary	    p r p

# Channel dimensions: Lx = 1.0e-3 m, H = 1.0e-3 m
variable            Lx equal 1.0e-3
variable            H equal 1.0e-3
variable            xmin equal 0.0
variable            xmax equal ${Lx}
variable            ymin equal 0.0
variable            ymax equal ${H}
variable            zmin equal -0.1
variable            zmax equal 0.1

# Grid: 60 cells in each direction (cell size = 1.667e-5 m <= lambda/3)
variable            Nx equal 60
variable            Ny equal 60
variable            Nz equal 1

create_box          ${xmin} ${xmax} ${ymin} ${ymax} ${zmin} ${zmax}
create_grid 	    ${Nx} ${Ny} ${Nz} block * * * 
balance_grid        rcb cell

# Species definition
species             argon.species Ar

# Mixture: Argon at rest, T=273 K initially
mixture             all Ar nrho 2.6e22 temp 273.0 vstream 0 0 0

# Particle count: Level 2 with ~80 particles per cell (4x level 1)
# fnum = real_particles / simulated_particles
# Real molecules per cell = n * dx * dy * 1 = 2.6e22 * (1e-3/60)^2 = 7.22e12
# For 80 particles/cell: fnum = 7.22e12 / 80 = 9.03e10
variable            fnum equal 9.03e10
global		    fnum ${fnum}

# Collision model: VSS for Argon
collide             vss all argon.vss

# Surface definitions for walls
read_surf	    walls.surf group 1

# Define surface groups based on line IDs
# Line 1 is bottom wall (cold), Line 2 is top wall (hot)
group               cold surf id 1
group               hot surf id 2

# Wall collision models: fully diffuse reflection
surf_collide        coldwall diffuse 223.0 1.0
surf_collide        hotwall diffuse 323.0 1.0

# Assign collision models to surface groups
surf_modify         cold collide coldwall
surf_modify         hot collide hotwall

# Initialize particles
create_particles    all n 0 twopass
balance_grid        rcb part

# Compute heat flux through surfaces
# etot = total energy flux (kinetic + rotational + vibrational)
compute             qflux_hot surf hot all etot
compute             qflux_cold surf cold all etot

# Time average the heat flux over sampling window
fix                 qave_hot ave/surf hot 1 1000 1000 c_qflux_hot[1] c_qflux_hot[1]
fix                 qave_cold ave/surf cold 1 1000 1000 c_qflux_cold[1] c_qflux_cold[1]

# Reduce to get total heat flux through each wall (sum over surface elements)
compute             qtot_hot reduce sum f_qave_hot[1]
compute             qtot_cold reduce sum f_qave_cold[1]

# Output statistics including the reduced totals
stats_style         step cpu np nattempt ncoll nscoll nscheck c_qtot_hot c_qtot_cold
stats               1000

# Timestep: dt = 2.0e-8 s
timestep            2.0e-8

# Run: 10000 steps warmup + 10000 steps sampling = 20000 total (reduced for faster completion)
run                 20000
