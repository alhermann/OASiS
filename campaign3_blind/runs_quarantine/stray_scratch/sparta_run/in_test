seed	    	    42
dimension   	    2
global		    gridcut 0.0 comm/sort yes
boundary	    p r p
variable            Lx equal 1.0e-3
variable            H equal 1.0e-3
create_box          0 ${Lx} 0 ${H} -0.1 0.1
create_grid 	    60 60 1 block * * * 
balance_grid        rcb cell
species             argon.species Ar
mixture             all Ar nrho 2.6e22 temp 273.0 vstream 0 0 0
variable            fnum equal 3.61e11
global		    fnum ${fnum}
collide             vss all argon.vss
read_surf	    walls.surf group 1
group               cold surf id 1
group               hot surf id 2
surf_collide        coldwall diffuse 223.0 1.0
surf_collide        hotwall diffuse 323.0 1.0
surf_modify         cold collide coldwall
surf_modify         hot collide hotwall
create_particles    all n 0 twopass
balance_grid        rcb part
compute             qflux_hot surf hot all etot
timestep            2.0e-8
run                 10
