<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
  <Module type="solid"/>
  <Control>
    <analysis>STATIC</analysis>
    <time_steps>1</time_steps>
    <step_size>1</step_size>
    <solver type="solid">
      <symmetric_stiffness>symmetric</symmetric_stiffness>
    </solver>
  </Control>
  <Material>
    <material id="1" name="Mat1" type="isotropic elastic">
      <density>1.0</density>
      <E>1000</E>
      <v>0.25</v>
    </material>
  </Material>
  <Mesh>
    <Nodes name="Object1">
      <node id="1">0,0,0</node>
      <node id="2">1,0,0</node>
      <node id="3">1,1,0</node>
      <node id="4">0,1,0</node>
      <node id="5">0,0,0.1</node>
      <node id="6">1,0,0.1</node>
      <node id="7">1,1,0.1</node>
      <node id="8">0,1,0.1</node>
    </Nodes>
    <Elements type="hex8" name="Part1">
      <elem id="1">1 2 3 4 5 6 7 8</elem>
    </Elements>
    <NodeSet name="all">1 2 3 4 5 6 7 8</NodeSet>
    <NodeSet name="fix">1 2 5 6</NodeSet>
  </Mesh>
  <MeshDomains>
    <SolidDomain name="Part1" mat="Mat1"/>
  </MeshDomains>
  <Boundary>
    <bc name="fix_bottom" type="zero displacement" node_set="fix">
      <x_dof>1</x_dof>
      <y_dof>1</y_dof>
      <z_dof>1</z_dof>
    </bc>
    <bc name="fix_z" type="zero displacement" node_set="all">
      <z_dof>1</z_dof>
    </bc>
  </Boundary>
  <Loads>
    <body_load type="const">
      <x>0.01</x>
      <y>0.01</y>
      <z>0</z>
    </body_load>
  </Loads>
  <Output>
    <plotfile type="febio">
      <var type="displacement"/>
      <var type="stress"/>
    </plotfile>
    <logfile>
      <node_data data="x;y;z;ux;uy;uz" delim="," file="nodal_output.csv"/>
    </logfile>
  </Output>
</febio_spec>
