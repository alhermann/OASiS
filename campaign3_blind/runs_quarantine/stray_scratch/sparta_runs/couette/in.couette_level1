################################################################################
# Couette flow between two parallel plates
# Top wall moves at +50 m/s, bottom wall moves at -50 m/s
# Periodic in x, diffuse walls in y
################################################################################

seed	    	    12345 
dimension   	    2     
global              gridcut 0.0

# Boundary conditions: periodic in x, reflective in y
boundary	    p r p

# Domain: x from 0 to Lx, y from 0 to H, z from -0.5 to 0.5 (unit thickness)
create_box  	    0.0 0.000166667 0.0 0.001 -0.5 0.5 

# Grid: 10 cells in x, 60 cells in y, 1 cell in z
create_grid 	    10 60 1 

balance_grid        rcb cell

# Define region for particle creation (entire domain)
region		    all_domain block 0.0 0.000166667 0.0 0.001 -0.5 0.5

# Species definition
species		    ar.species Ar

# Mixture: Argon gas at rest, T=273K, n=2.6e22 1/m^3
mixture		    argon Ar nrho 2.6e22 temp 273.0

# Global settings
# fnum calculated for ~20 particles per cell on average
global		    fnum 3.615e11 temp 273.0 

# Create particles uniformly throughout domain
create_particles    argon n 0 region all_domain twopass

# Read surface geometry for walls (use particle keep since particles already exist)
read_surf           walls.surf group all particle keep

# Create surface groups for each wall based on line ID
# Line 1 is bottom wall, Line 2 is top wall
group		    bottom_wall surf id 1
group		    top_wall surf id 2

# Surface collision models with wall velocities
surf_collide	    bottom diffuse 273.0 1.0 translate -50.0 0.0 0.0
surf_collide	    top diffuse 273.0 1.0 translate 50.0 0.0 0.0

# Assign collision models to surface groups
surf_modify         bottom_wall collide bottom
surf_modify         top_wall collide top

# Collision model: VSS
collide             vss argon ar.vss 

# Compute shear stress on ALL surfaces (will be non-zero only for assigned surfaces)
compute 	    s_all surf all argon shx shy shz press

# Time average the surface quantities
# Nevery=1: sample every timestep
# Nrepeat=30000: average over 30000 samples
# Nfreq=30000: output every 30000 timesteps
fix		    f_all ave/surf all 1 30000 30000 c_s_all[*]

# Dump the averaged surface quantities at the end
dump		        d_surf surf all 30000 surf_output.* id f_f_all[*]

# Output statistics every 1000 steps
stats		    1000 
stats_style	    step cpu np nattempt ncoll nscoll nscheck

timestep 	    2.0e-8 

run 		    50000
