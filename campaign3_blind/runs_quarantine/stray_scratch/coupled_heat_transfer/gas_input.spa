# SPARTA input file for conjugate heat transfer - gas side
# Geometry: rectangle (0.001, 0.002) x (0, 0.0006) meters
# Argon gas with VSS collision model

seed             12345
dimension        2

# Variable for interface temperature (will be updated by coupling script)
variable         interface_temp equal 300.0

# Grid parameters
# Mean free path lambda = 1.0e-4 m at 300 K
# Cell size should be <= lambda/3 = 3.3e-5 m
# Domain: dx = 0.001 m, dy = 0.0006 m
# Minimum cells: 30 in x, 18 in y
global           gridcut 0.0

# Boundary conditions: surface on left and right, periodic in y
boundary         s s p

# Create simulation box
create_box       0.001 0.002 0.0 0.0006 -0.1 0.1
create_grid      30 18 1 block * * *

balance_grid     rcb cell

# Species definition (argon) - use full path
species          /home/alexander/Schreibtisch/sparta/data/ar.species Ar

# Mixture definition
# n = 1.3327e+22 1/m^3 at 300 K
mixture          gas Ar nrho 1.3327e22 temp 300

# Collision model (VSS) - use full path
collide          vss all /home/alexander/Schreibtisch/sparta/data/ar.vss

# Surface collision models
# Interface wall (left boundary) - temperature will be set via variable
surf_collide     interface diffuse ${interface_temp} 1.0
# Right wall at 200 K
surf_collide     hotwall diffuse 200.0 1.0

# Assign collision models to boundaries
bound_modify     xlo collide interface
bound_modify     xhi collide hotwall

# Compute energy flux on interface wall
# etot gives total energy flux (kinetic + internal) in J/(m*s) for 2D
compute          1 isurf/grid all all etot

# Time average the energy flux
fix              1 ave/grid all 1 1 1 c_1[*] ave one

# Statistics output - just basic info
stats            100
stats_style      step cpu np nattempt ncoll

# Initialize particles
# fnum = n * volume / (ppc * nx * ny)
# volume = 0.001 * 0.0006 = 6e-7 m^2 (per unit depth in z)
# For 2D, we need to think about this differently
# Let's use a reasonable number of particles per cell
global           fnum 1.3327e19

create_particles gas n 25 twopass

# Timestep: max 1e-7 s
timestep         1e-8

# Run: 2000 equilibration + 4000 sampling = 6000 timesteps
run              6000
