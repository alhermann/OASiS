################################################################################
# Couette flow between two parallel plates - Level 2 (4x particles of Level 1)
# Top wall moves at +50 m/s, bottom wall moves at -50 m/s
# Periodic in x, diffuse walls in y
################################################################################

seed	    	    12345 
dimension   	    2     
global              gridcut 0.0

boundary	    p r p

create_box  	    0.0 0.000166667 0.0 0.001 -0.5 0.5 

create_grid 	    10 60 1 

balance_grid        rcb cell

region		    all_domain block 0.0 0.000166667 0.0 0.001 -0.5 0.5

species		    ar.species Ar

mixture		    argon Ar nrho 2.6e22 temp 273.0

# fnum_2 = fnum_1 / 4 = 3.615e11 / 4 = 9.0375e10
global		    fnum 9.0375e10 temp 273.0 

create_particles    argon n 0 region all_domain twopass

read_surf           walls.surf group all particle keep

group		    bottom_wall surf id 1
group		    top_wall surf id 2

surf_collide	    bottom diffuse 273.0 1.0 translate -50.0 0.0 0.0
surf_collide	    top diffuse 273.0 1.0 translate 50.0 0.0 0.0

surf_modify         bottom_wall collide bottom
surf_modify         top_wall collide top

collide             vss argon ar.vss 

compute 	    s_all surf all argon shx shy shz press

fix		    f_all ave/surf all 1 30000 30000 c_s_all[*]

dump		        d_surf surf all 30000 surf_output.* id f_f_all[*]

stats		    1000 
stats_style	    step cpu np nattempt ncoll nscoll nscheck

timestep 	    2.0e-8 

run 		    50000
