<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
  <Module type="solid"/>
  <Control>
    <analysis>STATIC</analysis>
    <time_steps>1</time_steps>
    <step_size>1</step_size>
  </Control>
  <Material>
    <material id="1" name="MaterialA" type="isotropic elastic">
      <density>1.0</density>
      <E>666.6666666666667</E>
      <v>0.25</v>
    </material>
  </Material>
  <Mesh>
    <Nodes name="Object1">
      <node id="1">0.0,0.0,0.0</node>
      <node id="2">0.3125,0.0,0.0</node>
      <node id="3">0.625,0.0,0.0</node>
      <node id="4">0.0,0.5,0.0</node>
      <node id="5">0.3125,0.5,0.0</node>
      <node id="6">0.625,0.5,0.0</node>
      <node id="7">0.0,1.0,0.0</node>
      <node id="8">0.3125,1.0,0.0</node>
      <node id="9">0.625,1.0,0.0</node>
    </Nodes>
    <Elements type="tri6" name="Part1">
      <elem id="1">1,2,5</elem>
      <elem id="2">1,5,4</elem>
      <elem id="3">2,3,6</elem>
      <elem id="4">2,6,5</elem>
      <elem id="5">4,5,8</elem>
      <elem id="6">4,8,7</elem>
      <elem id="7">5,6,9</elem>
      <elem id="8">5,9,8</elem>
    </Elements>
    <NodeSet name="outer_boundary">1 2 3 4 7 9</NodeSet>
  </Mesh>
  <MeshDomains>
    <SolidDomain name="Part1" mat="Material1"/>
  </MeshDomains>
  <Boundary>
    <bc name="fix_outer" type="zero displacement" node_set="outer_boundary">
      <x_dof>1</x_dof>
      <y_dof>1</y_dof>
      <z_dof>1</z_dof>
    </bc>
  </Boundary>
  <Loads>
    <body_load type="const">
      <x>0.01</x>
      <y>0.01</y>
      <z>0</z>
    </body_load>
  </Loads>
  <Output>
    <plotfile type="febio">
      <var type="displacement"/>
      <var type="stress"/>
    </plotfile>
    <logfile>
      <node_data data="x;y;z;ux;uy;uz" delim="," file="nodal_output.csv"/>
    </logfile>
  </Output>
</febio_spec>
